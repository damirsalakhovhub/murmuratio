#!/usr/bin/env python3
"""Fake `codex app-server` for tests: answers initialize and account/rateLimits/read only."""
import json
import os
import sys

if sys.argv[1:] != ['app-server']:
    sys.exit(2)
log = os.environ.get('FAKE_CODEX_LOG')
mode = os.environ.get('FAKE_CODEX_MODE', 'ok')
for line in sys.stdin:
    message = json.loads(line)
    if log:
        with open(log, 'a') as stream:
            stream.write(json.dumps(message) + '\n')
    method = message.get('method')
    if method == 'initialize':
        print(json.dumps({'id': message['id'], 'result': {'userAgent': 'fake'}}), flush=True)
    elif method == 'initialized':
        continue
    elif method == 'account/rateLimits/read':
        if mode == 'hang':
            continue
        if mode == 'error':
            print(json.dumps({'id': message['id'], 'error': {'code': -32600, 'message': 'not signed in'}}), flush=True)
            continue
        # Synthetic measurements in the Codex app-server response format.
        print(json.dumps({'method': 'account/rateLimits/updated', 'params': {}}), flush=True)
        print(json.dumps({'id': message['id'], 'result': {
            'ordinaryUsageAllowed': True,
            'rateLimits': {'limitId': 'codex', 'limitName': None,
                           'primary': {'usedPercent': 99, 'windowDurationMins': 10080, 'resetsAt': 2000000000},
                           'secondary': None,
                           'credits': {'hasCredits': True, 'unlimited': False, 'balance': '50000'},
                           'planType': 'pro', 'rateLimitReachedType': None}}}), flush=True)
    else:
        sys.exit(3)  # Anything else (for example consuming a reset credit) must never be sent.
